# ── Network IDS/IPS Configuration ──

# Database
DATABASE_URL=sqlite:///backend/database/nids.db

# API Server
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=change-me-in-production

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# Network Monitoring (Linux only)
# CAPTURE_INTERFACE=eth0
# ZEEK_LOG_DIR=/opt/zeek/logs/current
# SURICATA_EVE_PATH=/var/log/suricata/eve.json

# Mitigation (Linux only, disabled by default)
MITIGATION_ENABLED=false
MITIGATION_SIMULATION=true
MITIGATION_AUTO_BLOCK=false
